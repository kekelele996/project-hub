# 初次启动请替换密码；数据库密码使用字母数字及横线，避免 URL 特殊字符。
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
ADMIN_NAME=管理员
WEB_BIND=127.0.0.1
WEB_PORT=8088
# HTTPS 部署设 true；仅本机 HTTP 预览设 false。
SECURE_COOKIE=true
# GitHub 凭证加密密钥：openssl rand -base64 32；为空时关闭灾备配置。
# 必须独立备份，不能随意更换，否则已有凭证无法解密。
BACKUP_MASTER_KEY=
